# OpenAI-compatible LLM configuration.
# For DeepSeek, use deepseek-v4-flash by default and deepseek-v4-pro for thinking mode.
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=90

# Optional: print LangChain debug information.
LANGCHAIN_VERBOSE=false

# Optional real-world data providers.
# AMAP_API_KEY enables Gaode Maps geocoding, POI search and route distance tools.
# AMAP_JS_API_KEY and AMAP_JS_SECURITY_CODE enable browser-side interactive AMap views.
# QWEATHER JWT is preferred. API KEY is kept as fallback for QWeather requests.
# QWEATHER_API_KEY enables QWeather realtime and 3-day forecast weather data when JWT is not configured or fails.
# QWEATHER_API_HOST is required by the current QWeather API. Find it in QWeather Console -> Settings.
# AVIATIONSTACK_API_KEY enables fallback flight schedule/status search. It does not provide ticket prices.
# LetsFG enables local realtime flight ticket price search. It needs the letsfg package and Playwright Chromium.
# Search can be slow; timeout is intentionally short so Aviationstack can still be used as fallback.
# RAPIDAPI_KEY enables Booking.com hotel price search through RapidAPI.
AMAP_API_KEY=replace_with_your_amap_key
AMAP_JS_API_KEY=replace_with_your_amap_js_key
AMAP_JS_SECURITY_CODE=replace_with_your_amap_js_security_code
QWEATHER_API_KEY=replace_with_your_qweather_key
QWEATHER_API_HOST=replace_with_your_qweather_api_host
QWEATHER_JWT_KEY_ID=
QWEATHER_JWT_PROJECT_ID=
QWEATHER_JWT_PRIVATE_KEY_PATH=
QWEATHER_JWT_PRIVATE_KEY=
QWEATHER_JWT_PUBLIC_KEY_SHA256=
AVIATIONSTACK_API_KEY=replace_with_your_aviationstack_key
LETSFG_SEARCH_TIMEOUT=600
LETSFG_SEARCH_MODE=fast
LETSFG_MAX_BROWSERS=1
RAPIDAPI_KEY=replace_with_your_rapidapi_key
RAPIDAPI_HOST=booking-com15.p.rapidapi.com
