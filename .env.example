# OpenAI-compatible LLM configuration.
# For DeepSeek, use deepseek-v4-flash by default and deepseek-v4-pro for thinking mode.
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=90

# Optional: print LangChain debug information.
LANGCHAIN_VERBOSE=false

# Optional real-world data providers.
# AMAP_API_KEY enables Gaode Maps geocoding, POI search and route distance tools.
# AMAP_JS_API_KEY and AMAP_JS_SECURITY_CODE enable browser-side interactive AMap views.
# QWEATHER_API_KEY enables QWeather realtime and 3-day forecast weather data.
# QWEATHER_API_HOST is required by the current QWeather API. Find it in QWeather Console -> Settings.
# AVIATIONSTACK_API_KEY enables flight schedule/status search. It does not provide ticket prices.
AMAP_API_KEY=replace_with_your_amap_key
AMAP_JS_API_KEY=replace_with_your_amap_js_key
AMAP_JS_SECURITY_CODE=replace_with_your_amap_js_security_code
QWEATHER_API_KEY=replace_with_your_qweather_key
QWEATHER_API_HOST=replace_with_your_qweather_api_host
AVIATIONSTACK_API_KEY=replace_with_your_aviationstack_key
